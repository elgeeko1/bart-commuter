{
  "editor.formatOnSave": true,
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  // Pyright serves this workspace, and Pylance would duplicate its diagnostics
  "python.languageServer": "None",
  // ruff and mypy run from the virtual environment, at the versions of the pre-commit hooks
  "ruff.importStrategy": "fromEnvironment",
  "mypy-type-checker.importStrategy": "fromEnvironment",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.fixAll": "always",
      "source.organizeImports": "always"
    }
  },
  // Prettier and ESLint run from node_modules, at the versions of the pre-commit hooks
  "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[yaml]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "shellcheck.executablePath": "${workspaceFolder}/.venv/bin/shellcheck",
  "actionlint.executable": "${workspaceFolder}/.venv/bin/actionlint",
  // these formatters have no extension at the hook's version, so Run On Save runs the hooks
  "[markdown]": { "editor.formatOnSave": false },
  "[shellscript]": { "editor.formatOnSave": false },
  "[makefile]": { "editor.formatOnSave": false },
  "emeraldwalk.runonsave": {
    "commands": [
      {
        "match": "\\.md$",
        "cmd": "${workspaceFolder}/.venv/bin/pre-commit run mdformat --files \"${file}\""
      },
      {
        "match": "\\.sh$",
        "cmd": "${workspaceFolder}/.venv/bin/pre-commit run shfmt --files \"${file}\""
      },
      {
        "match": "/Makefile$",
        "cmd": "${workspaceFolder}/.venv/bin/pre-commit run mbake-format --files \"${file}\""
      }
    ]
  }
}
